[Unit]
Description=Headful Auth Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=headful-auth-tunnel
Group=headful-auth-tunnel
WorkingDirectory=/opt/headful-auth-tunnel
EnvironmentFile=-/etc/headful-auth-tunnel.env
Environment=PROFILE_DIR=/var/lib/headful-auth-tunnel/profile
Environment=RUNTIME_DIR=/var/lib/headful-auth-tunnel
Environment=TOKEN_FILE=/var/lib/headful-auth-tunnel/token
ExecStart=/opt/headful-auth-tunnel/scripts/run-foreground.sh /opt/headful-auth-tunnel/.venv/bin/headful-auth-tunnel
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/headful-auth-tunnel
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
